{
  "daemon": true,
  "run": [
    {
      "method": "shell.run",
      "params": {
        "message": "npm run dev",
        "on": [
          {
            "event": "/http:\\/\\/localhost:517\\d\\/?/",
            "done": true
          }
        ]
      }
    },
    {
      "method": "local.set",
      "params": {
        "url": "{{input.event[0]}}"
      }
    }
  ]
}
